<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · The Family</title><link rel="stylesheet" href="/assets/css/app.css"><script src="/assets/js/workspace.js" defer></script></head>
<body data-section="<%= section %>" data-member="<%= actor.member_id %>" data-role="<%= actor.role %>"><%- include('partials/sidebar') %><main class="main"><header class="topbar"><span>WORKSPACE <b>/</b> <%= title %></span><span class="badge"><%= actor.status %></span></header><section class="page"><div class="page-heading"><div><p class="eyebrow">THE FAMILY / OPERATIONS</p><h1><%= title %></h1><p class="muted">사람과 일을 연결하는 우리 조직의 운영 공간</p></div><div id="primary-actions"></div></div><div id="message" role="status" aria-live="polite"></div><div id="dashboard" class="cards"></div>
<section class="panel" id="listing"><div class="panel-header"><h2 id="list-title">현황 목록</h2><span class="muted" id="total"></span></div><form id="filters" class="filters"><label>키워드<input name="q" placeholder="이름 또는 제목 검색"></label><label>상태<input name="status" placeholder="예: ACTIVE"></label><label>Crew ID<input name="crew_id" type="number" min="1" placeholder="전체"></label><label>시작일<input name="from" type="datetime-local"></label><label>종료일<input name="to" type="datetime-local"></label><button type="submit" class="secondary">검색</button></form><div id="table" class="table-scroll"></div><div class="pagination"><button id="previous" class="quiet">← 이전</button><span id="page-number">1</span><button id="next" class="quiet">다음 →</button></div></section>
<section class="panel"><div class="panel-header"><div><h2>업무 도구</h2><p class="muted">필요한 작업을 선택해 등록·변경·조회할 수 있습니다.</p></div></div><div class="tools"><label>기능 찾기<input id="tool-search" placeholder="예: 업무 참여자 배정, 자원 반환"></label><label>작업<select id="operation"><option value="">작업 선택</option><% for(const op of operations){ %><option value="<%= op.operationId %>" data-definition="<%= JSON.stringify(op) %>"><%= op.title %></option><% } %></select></label><button id="open-operation" class="secondary">작업 열기</button></div><details><summary>세부 운영 메뉴</summary><div class="subnav"><% for(const [key,d] of Object.entries(entities).filter(([,d])=>!d.core)){ %><a href="/workspace/<%= key %>"><%= d.label %></a><% } %></div></details></section>
<p class="footnote">변경 이력은 저장 후 동기화될 때 표시됩니다. 이력이 아직 보이지 않으면 잠시 뒤 새로 조회하세요.</p></section></main>
<dialog id="editor"><div class="dialog-heading"><h2 id="editor-title">작업</h2><button id="close-editor" class="quiet" aria-label="닫기">×</button></div><p id="editor-description" class="muted"></p><form id="operation-form"><div id="operation-fields"></div><p id="form-message" role="status"></p><div class="dialog-footer"><button type="submit" id="submit-operation">저장</button></div></form><div id="operation-result"></div></dialog></body></html>
