<aside class="sidebar"><a class="wordmark" href="/">THE FAMILY<span>조직 운영 워크스페이스</span></a><p class="nav-label">WORKSPACE</p><nav aria-label="주요 메뉴"><% const menu=[['dashboard','운영 대시보드','◫'],['profile','내 정보','○'],['members','구성원','♧'],['crews','Crew','◇'],['tasks','업무','▣'],['assigned','내 배정 업무','✓'],['resources','공용 자원','▱'],['evaluations','평가','☆'],['activity','활동 기록','↺']]; if(['Capo','Underboss','Boss','Administrator'].includes(actor.role))menu.push(['reports','운영 통계','▥']);if(actor.role==='Administrator')menu.push(['admin','계정 및 감사','⚙']); %><% for(const [key,label,icon] of menu){ %><a href="<%= key==='dashboard'?'/':'/workspace/'+key %>" class="<%= section===key?'selected':'' %>" <%- section===key?'aria-current="page"':'' %>><span><%= icon %></span><%= label %></a><% } %></nav><div class="sidebar-bottom"><a href="/api-docs">API 문서 ↗</a><div class="avatar"><%= actor.name.slice(0,1) %></div><strong><%= actor.name %></strong><small><%= actor.role %></small><button id="logout" class="quiet">로그아웃</button></div></aside>
